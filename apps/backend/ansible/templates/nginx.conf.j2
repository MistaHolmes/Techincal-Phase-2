# ----------------------------
# DraftDock — User BE (HTTP / API)
# ----------------------------

server {
    listen 80;
    server_name {{ domains.user_be }};

    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:{{ api_port }};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_read_timeout    300s;
    }
}

# ----------------------------
# DraftDock — User BE (WebSocket)
# ----------------------------

server {
    listen 80;
    server_name {{ domains.user_be_ws }};

    location / {
        proxy_pass http://127.0.0.1:{{ ws_port }};
        proxy_http_version 1.1;

        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_read_timeout    600s;
    }
}

# ----------------------------
# TLS / HTTPS — served using certs from /etc/letsencrypt
# ----------------------------

server {
    listen 443 ssl http2;
    server_name {{ domains.user_be }};

    ssl_certificate /etc/letsencrypt/live/{{ domains.user_be }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domains.user_be }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:{{ api_port }};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_read_timeout    300s;
    }
}

server {
    listen 443 ssl http2;
    server_name {{ domains.user_be_ws }};

    ssl_certificate /etc/letsencrypt/live/{{ domains.user_be }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domains.user_be }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    location / {
        proxy_pass http://127.0.0.1:{{ ws_port }};
        proxy_http_version 1.1;

        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_read_timeout    600s;
    }
}
